@using Parkolóhely_foglaló.Model

@inject NavigationManager Navigation

<div class="ParkingSpotButton" @onclick="NavigateToReservation">
    <h2>@Spot.Name</h2>
    <p><strong>Location:</strong>@Spot.Location</p>
</div>

@code {
    [Parameter] public required ParkingSpot Spot { get; set; }

    private void NavigateToReservation()
    {
        Navigation.NavigateTo($"/spots/{Spot.Id}");
    }
}

