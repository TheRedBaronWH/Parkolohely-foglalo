@using Parkolóhely_foglaló.DB
@using Parkolóhely_foglaló.Model

@page "/Spots/SpotId"

<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px;">
@if (errorMessage != null)
{
    <h3> @errorMessage </h3>
}
else if (spot == null)
{
    <h3> Loading... </h3>
}
else
{
    <h3> Reservation at @spot.Name </h3>
    @if (errorMessage != null)
    {
        <h3> @errorMessage </h3>
    }
    else if (reservations == null)
    {
        <h3> Loading... </h3>
    }
    else if (reservations.Count() == 0)
    {
        <h3> No Reservations at this Parking Spot </h3>
    }
    else {
        @foreach (ParkingSpotReservation reservation in reservations)
        {
            <ReservationDetails Reservation="@reservation"/>
        }
    }
}
</div>

@code {
    [Parameter] public required int SpotId { get; set; }

    string? errorMessage = null;

    ParkingSpot? spot = null;
    List<ParkingSpotReservation>? reservations = null;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            spot = await DbApi.GetParkingSpot(SpotId);
            reservations = await DbApi.GetReservationsForSpot(spot);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}
