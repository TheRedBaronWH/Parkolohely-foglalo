@using Parkolóhely_foglaló.Components.Components
@using Parkolóhely_foglaló.DB
@using Parkolóhely_foglaló.Controller
@using Parkolóhely_foglaló.Model

@page "/reserve-user:{User}"

<h1 class="PageTitle">New Reservation for @User</h1>

@if(!string.IsNullOrEmpty(message))
{
    <h2 class="PageText"> @message </h2>
}

<div class="DateSelectorsGrid">
    <label for="startingTime">Starting Time:</label>
    <InputDate id="startingTime" Type="InputDateType.DateTimeLocal" @bind-Value="startingTime"/>
    <label for="endingTime">Ending Time:</label>
    <InputDate id="endingTime" Type="InputDateType.DateTimeLocal" @bind-Value="endingTime"/>
</div>

<div class="SearchButtonDiv">
    <button @onclick="Search"><h2>Search</h2></button>
</div>

@if(freeSpots!=null)
{
    if(freeSpots.Count == 0)
    {
        <h2 class="PageText">No free parking spots available at the selected timeslot.</h2>
    }
    else
    {
        <div class="FreeParkingSpotsGrid">
            @foreach(ParkingSpot spot in freeSpots)
            {
                <ParkingSpotButton Spot="spot" OnSpotClicked="() => SelectSpot(spot)" />
            }
        </div>
    }
}

@if(selectedSpot != null)
{
    <h2 class="PageText">Selected Spot: @selectedSpot.Name</h2>
    <button @onclick="Reserve">Reserve selected spot</button>
}

@code {
    [Parameter] public string User { get; set; }

    public DateTime startingTime { get; set; } = DateTime.Now;
    public DateTime endingTime { get; set; } = DateTime.Now.AddHours(1);

    public async Task Search()
    {
        if (startingTime < DateTime.Now)
        {
            message = "Starting time must be in the future!";
            return;
        }
        if (endingTime <= startingTime)
        {
            message = "Ending time must be after starting time!";
            return;
        }
        freeSpots = await DbApi.GetFreeParkingSpots(startingTime, endingTime);
    }

    public List<ParkingSpot>? freeSpots = null;
    public ParkingSpot? selectedSpot = null;

    public async Task SelectSpot(ParkingSpot spot)
    {
        selectedSpot = spot;
    }

    public string message = string.Empty;

    public async Task Reserve()
    {
        if (selectedSpot == null)
        {
            message = "Please select a Parking Spot!";
            return;
        }
        try
        {
            await ReservationHandler.TryAddReservation(User, selectedSpot, startingTime, endingTime);
            message = "Reservation Successful";
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }   
    }
}
