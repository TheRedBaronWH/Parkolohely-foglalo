@using Parkolóhely_foglaló.Components.Components
@using Parkolóhely_foglaló.DB
@using Parkolóhely_foglaló.Model
@using Parkolóhely_foglaló.Controller

@page "/spots-user:{User}/{SpotId:int}"

@if (spotLoadErrorMessage != null)
{
    <h3 class="PageTitle"> @spotLoadErrorMessage </h3>
}
else if (spot == null)
{
    <h3 class="PageTitle"> Loading... </h3>
}
else
{
    <h1 class="PageTitle"> Reservation at @spot.Name </h1>

    @if (!string.IsNullOrEmpty(deletionMessage))
    {
        <h3 class="PageText"> @deletionMessage </h3>
    }

    @if (reservationLoadErrorMessage != null)
    {
        <h3 class="PageText"> @reservationLoadErrorMessage </h3>
    }
    else if (reservations == null)
    {
        <h3 class="PageText"> Loading Reservations... </h3>
    }
    else if (reservations.Count() == 0)
    {
        <h3 class="PageText"> No Reservations at this Parking Spot </h3>
    }
    else
    {
        <div class="SpotReservationsGrid">
            @foreach (ParkingSpotReservation reservation in reservations)
            {
                @if (reservation.ReservedBy == User || User == "admin")
                {
                    <OwnedReservationDetails Reservation="@reservation" OnDeletionClicked="DeleteReservation" />
                }
                else
                {
                    <ReservationDetails Reservation="@reservation"/>
                }
            }
        </div>
    }
}


@code {
    [Parameter] public required int SpotId { get; set; }
    [Parameter] public required string User { get; set; }

    string? spotLoadErrorMessage = null;
    string? reservationLoadErrorMessage = null;
    string? deletionMessage = null;

    ParkingSpot? spot = null;
    List<ParkingSpotReservation>? reservations = null;
    protected override async Task OnInitializedAsync()
    {
        await PullParkingSpot();
        await PullReservations();
    }

    private async Task PullParkingSpot()
    {
        try
        {
            spot = await DbApi.GetParkingSpot(SpotId);
        }
        catch (Exception ex)
        {
            spotLoadErrorMessage = ex.Message;
        }
    }

    private async Task PullReservations()
    {
        try
        {
            reservations = await DbApi.GetReservationsForSpot(spot);
        }
        catch (Exception ex)
        {
            reservationLoadErrorMessage = ex.Message;
        }
    }

    public async void DeleteReservation(ParkingSpotReservation reservation)
    {
        try
        {
            await ReservationHandler.TryRemoveReservation(User, reservation);
            deletionMessage = "Reservation Deleted Successfully";
            await PullReservations();
        }
        catch (Exception ex)
        {
            deletionMessage = ex.Message;
        }
    }
}
